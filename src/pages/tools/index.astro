---
import BaseLayout from '../../layouts/BaseLayout.astro'; import { tools } from '../../lib/data';
---
<BaseLayout title="AI 工具对比｜AI价格地图" description="中立比较 ChatGPT、Claude、Gemini、Perplexity、Cursor 与 Midjourney 的订阅和适用场景。"><section class="mx-auto max-w-6xl px-4 py-12 sm:px-6 lg:px-8"><p class="eyebrow">Neutral comparison</p><h1 class="mt-2 text-4xl font-bold text-white">AI 工具对比</h1><p class="mt-4 max-w-3xl text-slate-400">价格为公开起售价或地区说明，功能与套餐会变化；不以营销口径代替实际试用与官方说明。</p><div class="mt-8 overflow-x-auto panel"><table class="min-w-[800px] w-full text-left text-sm"><thead class="bg-slate-900 text-xs uppercase tracking-wide text-slate-400"><tr><th class="px-5 py-4">工具</th><th class="px-5 py-4">免费版</th><th class="px-5 py-4">个人订阅月费</th><th class="px-5 py-4">核心优势</th><th class="px-5 py-4">适合人群</th></tr></thead><tbody class="divide-y divide-slate-800">{tools.map(tool => <tr class="hover:bg-slate-800/30"><td class="px-5 py-4 font-semibold text-white"><a target="_blank" rel="noreferrer" href={tool.url} class="hover:text-cyan-300">{tool.name} ↗</a></td><td class="px-5 py-4"><span class:list={[tool.free ? 'text-emerald-300' : 'text-slate-500']}>{tool.free ? '可用' : '未提供'}</span></td><td class="px-5 py-4 text-cyan-200">{tool.monthlyPrice}</td><td class="px-5 py-4 text-slate-300">{tool.strength}</td><td class="px-5 py-4 text-slate-400">{tool.audience}</td></tr>)}</tbody></table></div></section></BaseLayout>
