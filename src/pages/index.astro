---
import BaseLayout from '../layouts/BaseLayout.astro'; import { news, prices, tools, latestUpdated, formatCny, formatDate } from '../lib/data';
const path = (value: string) => `${import.meta.env.BASE_URL.replace(/\/$/, '')}${value}`;
const changes = [{ title: '日本区 Plus 折合人民币本周上涨 3.2%', type: '汇率变化', color: 'text-amber-300' }, { title: '土耳其区 Plus 应用商店参考价修正为 999.99 TRY', type: '数据修正', color: 'text-violet-300' }, { title: '美国区 Pro 公开价维持 US$200/月', type: '官方标价核验', color: 'text-cyan-300' }];
---
<BaseLayout><section class="grid-bg overflow-hidden border-b border-slate-800"><div class="mx-auto max-w-7xl px-4 py-20 sm:px-6 sm:py-28 lg:px-8"><p class="eyebrow">AI Price Intelligence · Beta</p><h1 class="mt-5 max-w-3xl text-4xl font-bold tracking-tight text-white sm:text-6xl">AI 情报，<span class="text-cyan-300">价格看得见</span></h1><p class="mt-6 max-w-2xl text-lg leading-8 text-slate-300">追踪全球 AI 产品动态、ChatGPT 地区价格与订阅变化。每天看 AI 新闻，订 GPT 前先查价格。</p><div class="mt-9 flex flex-wrap gap-3"><a href={path('/prices/')} class="rounded-xl bg-cyan-400 px-5 py-3 font-semibold text-slate-950 hover:bg-cyan-300">查看 GPT 各区价格</a><a href={path('/news/')} class="rounded-xl border border-slate-600 px-5 py-3 font-semibold text-white hover:bg-slate-800">查看今日 AI 快讯</a></div><p class="mt-8 text-xs text-slate-500">价格数据最近核验：{latestUpdated} · 人民币为估算，实际以结算页为准</p></div></section>
<section class="mx-auto max-w-7xl px-4 py-14 sm:px-6 lg:px-8"><div class="flex items-end justify-between"><div><p class="eyebrow">Daily brief</p><h2 class="section-title mt-2">今日 AI 快讯</h2></div><a class="text-sm text-cyan-300 hover:underline" href={path('/news/')}>全部快讯 →</a></div><div class="mt-7 grid gap-4 lg:grid-cols-2">{news.slice(0, 8).map(item => <article class="panel p-5 transition hover:-translate-y-0.5 hover:border-slate-600"><div class="flex items-center gap-2 text-xs text-slate-500"><span>{item.source}</span><span>·</span><time>{formatDate(item.publishedAt)}</time><span class="chip">{item.category}</span></div><h3 class="mt-3 text-lg font-semibold text-white"><a href={path(`/news/${item.slug}/`)} class="hover:text-cyan-300">{item.title}</a></h3><p class="mt-2 text-sm leading-6 text-slate-400">{item.summary}</p><div class="mt-4 flex gap-2">{item.companies.map(tag => <span class="text-xs text-cyan-300">#{tag}</span>)}</div></article>)}</div></section>
<section class="border-y border-slate-800 bg-slate-950/40"><div class="mx-auto max-w-7xl px-4 py-14 sm:px-6 lg:px-8"><div class="flex items-end justify-between"><div><p class="eyebrow">Price radar</p><h2 class="section-title mt-2">GPT 价格雷达</h2></div><a class="text-sm text-cyan-300 hover:underline" href={path('/prices/')}>完整价格地图 →</a></div><div class="mt-7 grid gap-3 sm:grid-cols-2 lg:grid-cols-4">{prices.filter(p=>p.plan==='Plus').slice(0,8).map(p => <a href={path(`/prices/${p.regionSlug}/`)} class="panel p-4 hover:border-cyan-800"><div class="flex justify-between"><span class="font-semibold text-white">{p.region}</span><span class="text-xs text-slate-500">{p.currency}</span></div><p class="mt-4 text-2xl font-bold">{formatCny(p.cny)}<span class="ml-1 text-xs font-normal text-slate-500">估算/月</span></p><p class="mt-1 text-sm text-slate-400">{p.price.toLocaleString('zh-CN')} {p.currency} · US${p.usd.toFixed(1)}</p><span class="mt-3 inline-block text-xs text-cyan-300">{p.confidence}</span></a>)}</div></div></section>
<section class="mx-auto max-w-7xl px-4 py-14 sm:px-6 lg:px-8"><p class="eyebrow">Change log</p><h2 class="section-title mt-2">近期价格变化</h2><div class="mt-7 grid gap-4 md:grid-cols-3">{changes.map(change => <article class="panel p-5"><p class:list={["text-sm font-medium",change.color]}>{change.type}</p><p class="mt-3 font-semibold text-white">{change.title}</p><p class="mt-3 text-xs text-slate-500">变动性质已标注，非购买建议。</p></article>)}</div></section>
<section class="border-y border-slate-800 bg-slate-950/40"><div class="mx-auto grid max-w-7xl gap-6 px-4 py-14 sm:px-6 lg:grid-cols-[1.25fr_.75fr] lg:px-8"><div><p class="eyebrow">AI Saving Stack</p><h2 class="section-title mt-2">把 AI 账单算清楚</h2><p class="mt-4 max-w-2xl leading-7 text-slate-400">比较公开月费、官方年付折扣与已核验的支付权益；返现测算会把年费、商户限制和资格限制一并算入。</p><a href={path('/saving-stack/')} class="mt-6 inline-flex rounded-xl bg-cyan-400 px-5 py-3 font-semibold text-slate-950 hover:bg-cyan-300">打开省钱雷达 →</a></div><div class="panel p-5"><p class="text-sm font-semibold text-white">不会收录的“省钱方式”</p><ul class="mt-4 space-y-2 text-sm leading-6 text-slate-400"><li>跨区或虚假地址</li><li>代充、礼品卡套利与转售订阅</li><li>未核验返现或夸大节省承诺</li></ul><p class="mt-4 text-xs text-slate-500">个人账单仅保存于当前浏览器。</p></div></div></section>
<section class="border-t border-slate-800 bg-slate-950/40"><div class="mx-auto max-w-7xl px-4 py-14 sm:px-6 lg:px-8"><div class="flex items-end justify-between"><div><p class="eyebrow">Tool comparison</p><h2 class="section-title mt-2">AI 工具推荐对比</h2></div><a class="text-sm text-cyan-300 hover:underline" href={path('/tools/')}>查看全部 →</a></div><div class="mt-7 grid gap-4 md:grid-cols-2 lg:grid-cols-3">{tools.map(tool => <article class="panel p-5"><div class="flex justify-between"><h3 class="font-semibold text-white">{tool.name}</h3><span class:list={["text-xs",tool.free ? 'text-emerald-300' : 'text-slate-500']}>{tool.free ? '有免费版' : '无免费版'}</span></div><p class="mt-3 text-sm text-cyan-300">{tool.monthlyPrice}</p><p class="mt-3 text-sm text-slate-400">{tool.strength}</p><p class="mt-2 text-xs text-slate-500">适合：{tool.audience}</p></article>)}</div></div></section></BaseLayout>
