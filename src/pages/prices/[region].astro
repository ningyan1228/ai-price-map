---
import BaseLayout from '../../layouts/BaseLayout.astro'; import { prices, history, formatCny } from '../../lib/data';
export function getStaticPaths() { return [...new Set(prices.map(p => p.regionSlug))].map(region => ({ params: { region } })); }
const region = Astro.params.region!; const entries = prices.filter(p => p.regionSlug === region); const title = entries[0]?.region || region;
const historyFor = (id: string) => history.filter(h => h.priceId === id);
---
<BaseLayout title={`${title} ChatGPT 价格｜AI价格地图`} description={`查询 ${title} ChatGPT 订阅公开标价、人民币估算、税费与渠道说明。`}><section class="mx-auto max-w-5xl px-4 py-12 sm:px-6 lg:px-8"><a href={`${import.meta.env.BASE_URL}prices/`} class="text-sm text-cyan-300 hover:underline">← 返回价格地图</a><p class="eyebrow mt-7">Region details</p><h1 class="mt-2 text-4xl font-bold text-white">{title} ChatGPT 价格</h1><p class="mt-4 max-w-3xl text-slate-400">公开标价和折算值仅作比较。请在自己的合法账户结算页确认货币、税费和订阅可用性。</p><div class="mt-8 space-y-4">{entries.map(p => <article class="panel p-5 sm:p-6"><div class="flex flex-col justify-between gap-4 sm:flex-row"><div><div class="flex items-center gap-3"><h2 class="text-xl font-bold text-white">ChatGPT {p.plan}</h2><span class="chip">{p.confidence}</span></div><p class="mt-4 text-3xl font-bold text-white">{p.price.toLocaleString('zh-CN')} {p.currency}<span class="ml-2 text-base font-normal text-slate-400">约 {formatCny(p.cny)} / US${p.usd.toFixed(1)}</span></p></div><a target="_blank" rel="noreferrer" href={p.source} class="h-fit rounded-lg border border-cyan-700 px-3 py-2 text-sm text-cyan-300 hover:bg-cyan-950">查看 {p.sourceName} ↗</a></div><dl class="mt-6 grid gap-4 border-t border-slate-800 pt-5 text-sm sm:grid-cols-3"><div><dt class="text-slate-500">税费提示</dt><dd class="mt-1 leading-6 text-slate-300">{p.taxNote}</dd></div><div><dt class="text-slate-500">渠道差异</dt><dd class="mt-1 leading-6 text-slate-300">{p.channelNote}</dd></div><div><dt class="text-slate-500">最后核验</dt><dd class="mt-1 text-slate-300">{p.verifiedAt}</dd></div></dl>{historyFor(p.id).length > 0 && <div class="mt-6 border-t border-slate-800 pt-5"><p class="text-sm font-semibold text-white">近期记录</p><div class="mt-3 flex flex-wrap gap-2">{historyFor(p.id).map(h => <span class="chip">{h.date} · {formatCny(h.cny)} · {h.changeType}</span>)}</div></div>}</article>)}</div></section></BaseLayout>
