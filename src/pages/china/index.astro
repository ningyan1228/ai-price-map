---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { news, formatDate } from '../../lib/data';
const path = (value: string) => `${import.meta.env.BASE_URL.replace(/\/$/, '')}${value}`;
const mainlandNews = news.filter((item) => item.market === 'mainland');
const groups = ['时政', '财经', '社会'];
---
<BaseLayout title="中国大陆新闻｜AI情报地图" description="聚合中国新闻网公开 RSS 的中国大陆时政、财经与社会新闻，仅提供标题、中文摘要与原文链接。">
  <section class="grid-bg border-b border-slate-800"><div class="mx-auto max-w-7xl px-4 py-14 sm:px-6 lg:px-8"><p class="eyebrow">Mainland China brief</p><h1 class="mt-2 text-4xl font-bold text-white sm:text-5xl">中国大陆新闻</h1><p class="mt-4 max-w-3xl leading-7 text-slate-300">优先聚合公开、可订阅的大陆新闻源。首批接入中国新闻网的时政、财经、社会 RSS；本站仅保留标题、日期、简短摘要与原始来源链接。</p><div class="mt-6 flex flex-wrap gap-2">{groups.map(group => <a href={`#${group}`} class="chip hover:border-cyan-700 hover:text-cyan-200">{group}</a>)}</div></div></section>
  <section class="mx-auto max-w-7xl px-4 py-12 sm:px-6 lg:px-8">{mainlandNews.length ? <div class="space-y-12">{groups.map(group => { const entries = mainlandNews.filter(item => item.category === group); return entries.length ? <section id={group}><div class="flex items-end justify-between"><div><p class="eyebrow">{group}</p><h2 class="section-title mt-2">中国大陆 {group} 新闻</h2></div><span class="text-sm text-slate-500">{entries.length} 条公开更新</span></div><div class="mt-6 grid gap-4 lg:grid-cols-2">{entries.map(item => <article class="panel p-5"><div class="flex flex-wrap items-center gap-2 text-xs text-slate-500"><span>{item.source}</span><span>·</span><time>{formatDate(item.publishedAt)}</time><span class="chip">{item.category}</span></div><h3 class="mt-3 text-lg font-semibold text-white"><a href={path(`/news/${item.slug}/`)} class="hover:text-cyan-300">{item.title}</a></h3><p class="mt-3 text-sm leading-6 text-slate-400">{item.summary}</p><a href={path(`/news/${item.slug}/`)} class="mt-4 inline-block text-sm text-cyan-300 hover:underline">阅读摘要与来源 →</a></article>)}</div></section> : null })}</div> : <div class="panel p-7"><h2 class="text-xl font-bold text-white">正在等待公开新闻源更新</h2><p class="mt-3 text-slate-400">定时更新失败不会影响网站；当前数据不会被空结果覆盖。请稍后重试或检查 GitHub Actions 日志。</p></div>}</section>
</BaseLayout>
