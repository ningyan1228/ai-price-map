---
import BaseLayout from '../../layouts/BaseLayout.astro'; import { news, formatDate } from '../../lib/data';
export function getStaticPaths() { return news.map(item => ({ params: { slug: item.slug } })); }
const item = news.find(n => n.slug === Astro.params.slug)!;
---
<BaseLayout title={`${item.title}｜AI价格地图`} description={item.summary}><article class="mx-auto max-w-3xl px-4 py-12 sm:px-6"><a href={`${import.meta.env.BASE_URL}news/`} class="text-sm text-cyan-300 hover:underline">← 返回 AI 快讯</a><div class="mt-8 flex flex-wrap gap-2">{item.companies.map(tag => <span class="chip">{tag}</span>)}<span class="chip">{item.category}</span></div><h1 class="mt-5 text-3xl font-bold leading-tight text-white sm:text-5xl">{item.title}</h1><p class="mt-5 text-sm text-slate-500">{item.source} · {formatDate(item.publishedAt)}</p><div class="panel mt-8 p-6 text-lg leading-9 text-slate-300"><p>{item.summary}</p><p class="mt-5 text-sm leading-6 text-slate-500">为尊重原始内容的版权与来源，本页不转载全文。请通过下方链接阅读完整公告。</p></div><a href={item.sourceUrl} target="_blank" rel="noreferrer" class="mt-7 inline-block rounded-xl bg-cyan-400 px-5 py-3 font-semibold text-slate-950 hover:bg-cyan-300">查看原文：{item.source} ↗</a></article></BaseLayout>
