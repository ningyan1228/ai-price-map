---
import BaseLayout from '../../layouts/BaseLayout.astro'; import { news, formatDate } from '../../lib/data';
const path = (value: string) => `${import.meta.env.BASE_URL.replace(/\/$/, '')}${value}`;
const globalNews = news.filter(item => item.market !== 'mainland');
---
<BaseLayout title="全球 AI 快讯｜AI情报地图" description="由官方博客、公告和合规 RSS 聚合的全球 AI 快讯。"><section class="mx-auto max-w-5xl px-4 py-12 sm:px-6 lg:px-8"><p class="eyebrow">Official-first digest</p><h1 class="mt-2 text-4xl font-bold text-white">全球 AI 快讯</h1><p class="mt-4 text-slate-400">优先收录公司官方博客、公告和公开 RSS；我们只提供中文摘要与原文链接。<a href={path('/china/')} class="ml-2 text-cyan-300 hover:underline">查看中国大陆新闻 →</a></p><div class="mt-8 space-y-4">{globalNews.map(item => <article class="panel p-5 sm:p-6"><div class="flex flex-wrap items-center gap-2 text-xs text-slate-500"><span>{item.source}</span><span>·</span><time>{formatDate(item.publishedAt)}</time><span class="chip">{item.category}</span>{item.companies.map(tag => <span class="text-cyan-300">#{tag}</span>)}</div><h2 class="mt-3 text-xl font-semibold text-white"><a href={path(`/news/${item.slug}/`)} class="hover:text-cyan-300">{item.title}</a></h2><p class="mt-3 leading-7 text-slate-400">{item.summary}</p><a href={path(`/news/${item.slug}/`)} class="mt-4 inline-block text-sm text-cyan-300 hover:underline">阅读摘要与来源 →</a></article>)}</div></section></BaseLayout>
