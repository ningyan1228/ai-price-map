---
import BaseLayout from '../../layouts/BaseLayout.astro'; import { history, prices, formatCny } from '../../lib/data';
const rows = history.map(h => ({ ...h, price: prices.find(p => p.id === h.priceId) })).filter(r => r.price);
---
<BaseLayout title="涨价降价记录｜AI价格地图" description="查看 ChatGPT 地区订阅价格的官方定价、汇率、税费与数据修正记录。"><section class="mx-auto max-w-6xl px-4 py-12 sm:px-6 lg:px-8"><p class="eyebrow">Price history</p><h1 class="mt-2 text-4xl font-bold text-white">涨价降价记录</h1><p class="mt-4 max-w-3xl text-slate-400">每条记录明确区分官方定价、汇率、税费和数据修正。折算成本变化不等于官方价格调整。</p><div class="mt-8 grid gap-5 lg:grid-cols-[1.1fr_.9fr]"><div class="panel p-5"><div class="flex items-center justify-between"><h2 class="font-semibold text-white">日本 Plus · 人民币折算趋势</h2><div class="flex gap-1"><button class="rounded bg-slate-800 px-2 py-1 text-xs text-cyan-300">30 天</button><button class="px-2 py-1 text-xs text-slate-500">90 天</button><button class="px-2 py-1 text-xs text-slate-500">全部</button></div></div><svg viewBox="0 0 500 180" class="mt-6 w-full" role="img" aria-label="日本 Plus 人民币折算价格趋势"><path d="M20 145 H480 M20 90 H480 M20 35 H480" stroke="#1e293b"/><polyline points="35,130 245,92 465,67" fill="none" stroke="#22d3ee" stroke-width="4" stroke-linecap="round" stroke-linejoin="round"/><circle cx="35" cy="130" r="5" fill="#22d3ee"/><circle cx="245" cy="92" r="5" fill="#22d3ee"/><circle cx="465" cy="67" r="5" fill="#22d3ee"/><text x="20" y="170" fill="#64748b" font-size="12">7/01 ¥142</text><text x="205" y="170" fill="#64748b" font-size="12">7/15 ¥145</text><text x="400" y="170" fill="#64748b" font-size="12">8/01 ¥147</text></svg><p class="mt-3 text-xs text-slate-500">MVP 使用轻量 SVG 图表；后续可替换为交互图表库。筛选、收藏地区和价格提醒的数据接口已在数据模型中预留。</p></div><aside class="panel p-5"><h2 class="font-semibold text-white">变动类型</h2><ul class="mt-4 space-y-3 text-sm text-slate-400"><li><span class="text-cyan-300">官方定价</span>：服务方公开标价变更</li><li><span class="text-amber-300">汇率</span>：当地标价未变，人民币估算变动</li><li><span class="text-violet-300">税费</span>：税率或含税规则变化</li><li><span class="text-slate-300">数据修正</span>：来源或记录更正</li></ul></aside></div><div class="mt-8 overflow-x-auto panel"><table class="min-w-[760px] w-full text-left text-sm"><thead class="bg-slate-900 text-xs uppercase tracking-wide text-slate-400"><tr><th class="px-5 py-3">日期</th><th class="px-5 py-3">地区 / 套餐</th><th class="px-5 py-3">变动前 → 后</th><th class="px-5 py-3">类型</th><th class="px-5 py-3">说明 / 来源</th></tr></thead><tbody class="divide-y divide-slate-800">{rows.slice().reverse().map((row, i) => { const previous = rows.filter(x=>x.priceId === row.priceId && x.date < row.date).at(-1); return <tr><td class="px-5 py-4 text-slate-400">{row.date}</td><td class="px-5 py-4 font-medium text-white">{row.price!.region} · {row.price!.plan}</td><td class="px-5 py-4">{previous ? `${formatCny(previous.cny)} → ` : '新增记录 → '}{formatCny(row.cny)}</td><td class="px-5 py-4"><span class="chip">{row.changeType}</span></td><td class="px-5 py-4 text-slate-400">{row.note}<br/><span class="text-xs text-slate-500">{row.source}</span></td></tr>})}</tbody></table></div></section></BaseLayout>
