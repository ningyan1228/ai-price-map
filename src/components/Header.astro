---
const links = [
  ['首页', '/'], ['AI 快讯', '/news/'], ['GPT 价格地图', '/prices/'], ['额度观察', '/quota-watch/'], ['AI 工具对比', '/tools/'], ['涨价降价记录', '/history/'], ['关于本站', '/about/']
];
const current = Astro.url.pathname;
const path = (value: string) => `${import.meta.env.BASE_URL.replace(/\/$/, '')}${value === '/' ? '/' : value}`;
---
<header class="sticky top-0 z-30 border-b border-slate-800/80 bg-[#070b16]/90 backdrop-blur">
  <div class="mx-auto flex max-w-7xl items-center justify-between px-4 py-3 sm:px-6 lg:px-8">
    <a href={path('/')} class="flex items-center gap-2 font-bold tracking-tight text-white"><span class="grid h-8 w-8 place-items-center rounded-lg bg-gradient-to-br from-cyan-400 to-blue-600 text-sm text-slate-950">AI</span>AI价格地图</a>
    <nav class="hidden items-center gap-1 lg:flex">{links.map(([name, href]) => <a href={path(href)} class:list={["rounded-lg px-3 py-2 text-sm transition", current === href ? "bg-slate-800 text-white" : "text-slate-400 hover:bg-slate-900 hover:text-white"]}>{name}</a>)}</nav>
    <a href={path('/prices/')} class="rounded-lg bg-cyan-400 px-3 py-2 text-sm font-semibold text-slate-950 hover:bg-cyan-300">查价格</a>
  </div>
  <nav class="flex overflow-x-auto border-t border-slate-800 px-3 py-2 lg:hidden">{links.map(([name, href]) => <a href={path(href)} class="whitespace-nowrap px-3 text-xs text-slate-400">{name}</a>)}</nav>
</header>
